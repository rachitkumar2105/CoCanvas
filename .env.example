# Copy to .env and adjust for local use. docker-compose.yml already provides working
# defaults for local dev; this file matters once you deploy outside Compose.

DB_URL=jdbc:postgresql://localhost:5432/cocanvas
DB_USERNAME=cocanvas
DB_PASSWORD=cocanvas

# HMAC-SHA256 signing secret shared between core-api and sync-service. Must be
# unpredictable and at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-real-secret-before-deploying-anywhere

CORS_ALLOWED_ORIGINS=http://localhost:3000
REDIS_URL=redis://localhost:6379
