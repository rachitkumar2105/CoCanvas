# Copy to .env and adjust for local use. docker-compose.yml already provides working
# defaults for local dev; this file matters once you deploy outside Compose.
# (frontend/.env.example covers the frontend's own two NEXT_PUBLIC_* variables.)

# ---- Shared by both services ----

# HMAC signing secret for user JWTs (access/refresh/collab tokens) — the Core API
# signs, the Sync Service independently verifies (Section 8). Must be unpredictable
# and at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-real-secret-before-deploying-anywhere

# Shared secret for service-to-service trust on /internal/** (both directions — the
# Sync Service presents it to the Core API for snapshot read/write, and the Core API
# presents it back to the Sync Service to push a restored version into a live
# session). Not a user credential, and not the same secret as JWT_SECRET above.
INTERNAL_SYNC_SECRET=replace-me-with-a-different-real-secret

# Comma-separated allow-list: CORS on both services' HTTP APIs, and Origin validation
# on the Sync Service's WebSocket upgrade (Section 5's security checklist).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Core API (core-api/) ----

DB_URL=jdbc:postgresql://localhost:5432/cocanvas
DB_USERNAME=cocanvas
DB_PASSWORD=cocanvas

SERVER_PORT=8080

# Token lifetimes (seconds). The collab token is intentionally short (Section 8) — it's
# re-issued by the frontend on every Sync Service reconnect, not held long-term.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
JWT_COLLAB_TTL=60

# Where the Core API reaches the Sync Service to push a restored version into any live
# session (VersionService -> SyncServiceClient). In docker-compose this is the service
# name (http://sync-service:4000); outside Compose, wherever it's actually reachable.
SYNC_SERVICE_INTERNAL_URL=http://localhost:4000

# Rate limits (Section 3 Tier 2) — requests allowed per window.
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_DOC_CREATE_MAX=30
RATE_LIMIT_DOC_CREATE_WINDOW_SECONDS=60

# ---- Sync Service (sync-service/) ----

PORT=4000
REDIS_URL=redis://localhost:6379

# Where the Sync Service reaches the Core API for snapshot persistence/hydration
# (persistence/coreApiClient.ts). In docker-compose this is the service name
# (http://core-api:8080); outside Compose, wherever it's actually reachable.
CORE_API_INTERNAL_URL=http://localhost:8080

# pino log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
