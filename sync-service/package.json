{
  "name": "cocanvas-sync-service",
  "version": "0.1.0",
  "private": true,
  "description": "CoCanvas Realtime Sync Service — Yjs relay, collab-token auth, snapshot persistence via the Core API. Phase 2: single-client document sync with persistence; presence/multi-client convergence is Phase 3.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2",
    "lib0": "^0.2.99",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.19"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
