{
  "name": "cocanvas-sync-service",
  "version": "0.1.0",
  "private": true,
  "description": "CoCanvas Realtime Sync Service — Yjs relay, collab-token auth, snapshot persistence via the Core API. Phase 2: single-client document sync with persistence; presence/multi-client convergence is Phase 3.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2",
    "lib0": "^0.2.99",
    "pino": "^10.3.1",
    "redis": "^6.2.1",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.19"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.19.43",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
